---
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
---

<Base
  title="Accessibility | Lezco Plumbing"
  description="Accessibility statement for the Lezco Plumbing website."
>
  <main id="main" class="page">
    <div class="wrap prose">
      <h1>Accessibility</h1>
      <p>
        This site is built with semantic headings, skip-to-content, readable contrast, and text that does not rely on hover alone. If a page is hard to use, email {site.email} or call {site.phoneDisplay} and we will help you schedule by phone.
      </p>
    </div>
  </main>
</Base>
