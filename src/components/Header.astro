---
import { site, navCities, navServices } from "../data/site";

const path = Astro.url.pathname;

function current(href: string) {
  return path === href ? "page" : undefined;
}
---

<a class="skip" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src={site.logo} alt={site.name} width="52" height="51" />
      <span class="brand-place">Lake Forest, CA</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      Menu
    </button>
    <nav class="nav" id="site-nav">
      <a href="/" aria-current={current("/")}>Home</a>
      <details>
        <summary>Services</summary>
        <div class="menu">
          <a href="/plumbing-services/">All services</a>
          {navServices.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <details>
        <summary>Service area</summary>
        <div class="menu">
          <a href="/service-area/">Cities we serve</a>
          {navCities.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      <a href="/about-us/" aria-current={current("/about-us/")}>About</a>
      <a href="/contact-us/" aria-current={current("/contact-us/")}>Contact</a>
      <a class="call" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
